LLM_URL=http://<llm-host>:8000
SYNC_SECRET=<random-hex>
# 공부 기록 DB — postgres 컨테이너가 이 값으로 처음 만들어지고, 앱의 STUDY_DB_URL 도 docker-compose.yml 이 이 값으로 조립한다.
# 처음 뜬 뒤(data/postgres 가 생긴 뒤)에 바꾸면 DB 쪽은 바뀌지 않는다. 비밀번호는 영문 · 숫자만(`$` 는 compose 가 변수로 읽는다).
STUDY_DB_NAME=study
STUDY_DB_USER=study
STUDY_DB_PASSWORD=<random-hex>
