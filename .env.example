LLM_URL=http://<llm-host>:8000
SYNC_SECRET=<random-hex>
# 주인 표시 쿠키(study_owner)의 서명 열쇠 — 어드민과 같은 값 · 32바이트 이상 · 다른 비밀값과 따로. 비면 누구도 주인이 아니다(Claude 로 가는 경로는 모두 403)
OWNER_COOKIE_SECRET=
# 공부 기록 DB — postgres 컨테이너가 이 값으로 처음 만들어지고, 앱의 STUDY_DB_URL 도 docker-compose.yml 이 이 값으로 조립한다.
# 처음 뜬 뒤(data/postgres 가 생긴 뒤)에 바꾸면 DB 쪽은 바뀌지 않는다. 비밀번호는 영문 · 숫자만(`$` 는 compose 가 변수로 읽는다).
STUDY_DB_NAME=study
STUDY_DB_USER=study
STUDY_DB_PASSWORD=<random-hex>
# Redis 의 AOF 다시 쓰기 주기(초 · 선택 — 기본 1800). redis-aof-rewrite 가 이만큼마다 BGREWRITEAOF 를 시킨다 — 지운 방문의 원문이 디스크에 남는 시간을 정한다.
# 60 이상의 정수만 받는다. 그 밖의 값(0 · 음수 · 글자 · `30m` 같은 단위)은 로그에 `redis-aof-rewrite: BAD-INTERVAL` 한 줄을 남기고 1800 으로 돈다. 값을 비워 두면(`…SECONDS=`) compose 가 기본 1800 으로 바꾼다(그 줄은 없다).
# REDIS_AOF_REWRITE_INTERVAL_SECONDS=1800
